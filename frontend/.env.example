# === SUPABASE (The only backend platform) ===
# All CRUD, Auth, Storage, Realtime, AI, and Business Logic
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# === SENTRY (Error Monitoring) ===
# Required for Sentry to capture frontend errors.
# Omit for local/dev — the integration stays inert.
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Optional release tag (e.g. git commit SHA) attached to every event.
# If omitted, releases are derived from git by @sentry/vite-plugin at build
# time only when SENTRY_AUTH_TOKEN is set in the build environment.
VITE_SENTRY_RELEASE=

# === POSTHOG (Product Analytics) ===
# Required for product event capture (login, dashboard_open, …).
# Omit for local — captureEvent() stays inert.
VITE_POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com when unset.
VITE_POSTHOG_HOST=

# === SENTRY SOURCE MAP UPLOAD (build-time only, never VITE_ prefix) ===
# Set in the build environment (Vercel/CI), NOT in .env files:
#   SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# When present, @sentry/vite-plugin uploads dist/assets/*.map to Sentry and
# injects the release into the bundle. Without them, builds ship without
# source maps in public (vite hides them) and no upload occurs.
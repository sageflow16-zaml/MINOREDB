# =============================================================================
# Minore Frontend — Environment Variables
# Copy this file to .env for local development.
# Vercel sets these via Dashboard → Project Settings → Environment Variables.
# =============================================================================

# In production, set this to the Render backend URL.
# For local dev, use '/api/v1' (proxied via Vite).
VITE_API_URL=https://project-minore.onrender.com/api/v1

# Local dev only: Vite proxy target
VITE_API_PROXY=http://127.0.0.1:8000

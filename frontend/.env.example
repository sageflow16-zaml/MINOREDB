# =============================================================================
# Minore Frontend — Environment Variables
# Copy this file to .env for local development.
# Vercel sets these via Dashboard → Project Settings → Environment Variables.
# =============================================================================

# In production (Vercel), the API is served at the same domain via serverless
# functions at /api/v1/* — no separate URL needed. For local dev, Vite proxies
# /api/v1 requests to the backend on port 8000 (see VITE_API_PROXY).
VITE_API_URL=/api/v1

# Local dev only: Vite proxy target
VITE_API_PROXY=http://127.0.0.1:8000

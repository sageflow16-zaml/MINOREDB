{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src"],
  "exclude": [
    "src/pages/Analytics.tsx",
    "src/pages/Claims.tsx",
    "src/pages/Concepts.tsx",
    "src/pages/Conflicts.tsx",
    "src/pages/Dashboard.tsx",
    "src/pages/GraphExplorer.tsx",
    "src/pages/Hypotheses.tsx",
    "src/pages/Interpretations.tsx",
    "src/pages/ResearchQuestions.tsx",
    "src/pages/Search.tsx",
    "src/pages/Sources.tsx",
    "src/hooks/useClaims.ts",
    "src/hooks/useConcepts.ts",
    "src/hooks/useConflicts.ts",
    "src/hooks/useDashboard.ts",
    "src/hooks/useGraph.ts",
    "src/hooks/useInterpretations.ts",
    "src/hooks/useResearch.ts",
    "src/hooks/useSearch.ts",
    "src/hooks/useSources.ts",
    "src/hooks/useProjectMutations.ts",
    "src/components/ClaimCount.tsx",
    "src/components/ConceptDrawer.tsx",
    "src/components/ConflictDrawer.tsx",
    "src/components/CreateProjectModal.tsx",
    "src/components/DataTable.tsx",
    "src/components/InterpretationDrawer.tsx",
    "src/components/PageHeader.tsx",
    "src/components/SourceDrawer.tsx",
    "src/components/StatCard.tsx",
    "src/components/graph",
    "src/routes/AppRoutes.tsx",
    "src/pages/ProjectSettings.tsx"
  ]
}

# ── Database (required) ────────────────────────────────────────────────
DATABASE_URL=postgresql://minore:minore@localhost:5432/minore

# ── Server Port ────────────────────────────────────────────────────────
PORT=8000

# ── Environment ────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS (comma-separated origins) ─────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── JWT Authentication (REQUIRED — generate with: openssl rand -hex 32) ─
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars-long

# ── Optional API Key for machine-to-machine access ─────────────────────
API_KEY=
WEBHOOK_SECRET=

# ── Rate Limiting (requests per minute, 0 to disable) ──────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Request Limits (bytes) ─────────────────────────────────────────────
MAX_REQUEST_SIZE=10485760

# ── Docs (disable in production) ───────────────────────────────────────
DOCS_ENABLED=true

# ── HSTS (enable behind TLS only) ──────────────────────────────────────
HSTS_ENABLED=false

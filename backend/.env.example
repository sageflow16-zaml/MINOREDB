# Database
DATABASE_URL=postgresql+psycopg://minore:minore@localhost:5432/minore

# Environment
ENVIRONMENT=production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Security
API_KEY=
WEBHOOK_SECRET=

# Rate Limiting (requests per minute, 0 to disable)
RATE_LIMIT_PER_MINUTE=100

# Request Limits (bytes)
MAX_REQUEST_SIZE=10485760

# Docs (disable in production)
DOCS_ENABLED=false

# HSTS (enable behind TLS)
HSTS_ENABLED=false

# =============================================================================
# Minore Backend — Production Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with secrets to version control.
# =============================================================================
#
# VERCEL DEPLOYMENT: Set ALL variables below in Vercel Dashboard →
#   Project Settings → Environment Variables. The Vercel Python runtime
#   reads environment variables automatically — no .env file needed on Vercel.

# === DATABASE (Neon PostgreSQL) =============================================
# Get this from Neon Dashboard → Connection Details → Connection string
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# IMPORTANT: Use pooled connection string from Neon for serverless:
#   postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb

# === AUTH / JWT =============================================================
# Generate with: openssl rand -hex 32
# (or: python -c "import secrets; print(secrets.token_hex(32))")
# MUST be at least 32 characters. NEVER use the default in production.
JWT_SECRET_KEY=change-me-to-a-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === API KEYS (optional) ====================================================
# API_KEY=your-machine-to-machine-key
# WEBHOOK_SECRET=your-webhook-secret

# === SERVER ==================================================================
# Used only by uvicorn locally; Vercel ignores PORT.
PORT=10000
ENVIRONMENT=production

# === CORS ====================================================================
# Comma-separated list of allowed origins (no trailing slashes).
# Vercel deployment domain MUST be listed here.
CORS_ORIGINS=https://project-minore.vercel.app,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-API-Key,X-Request-ID

# === SECURITY ================================================================
# Comma-separated allowed Host header values. Set to your Vercel domain.
# Empty = TrustedHost middleware disabled (not recommended for production).
ALLOWED_HOSTS=.vercel.app,localhost
DOCS_ENABLED=false
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Rate limiting: disabled on Vercel (in-memory limiter resets per cold start).
# Set to 0 to disable, or a positive integer to limit requests/minute locally.
RATE_LIMIT_PER_MINUTE=0

# Request/payload size limits in bytes. 0 = unlimited.
MAX_REQUEST_SIZE=10485760
MAX_UPLOAD_SIZE=5242880
MAX_PAGE_SIZE=1000

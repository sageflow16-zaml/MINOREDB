# ── Database (required) ────────────────────────────────────────────────
# Railway provides this automatically via the PostgreSQL plugin.
# Scheme: "postgresql://" works with psycopg2-binary (installed).
DATABASE_URL=postgresql://minore:minore@localhost:5432/minore

# ── Server Port ────────────────────────────────────────────────────────
# Railway injects $PORT dynamically. 8000 is the fallback for local dev.
PORT=8000

# ── Environment ────────────────────────────────────────────────────────
# "development" | "production" | "test"
ENVIRONMENT=production

# ── CORS (comma-separated origins) ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Security ───────────────────────────────────────────────────────────
API_KEY=
WEBHOOK_SECRET=

# ── Rate Limiting (requests per minute, 0 to disable) ──────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Request Limits (bytes) ─────────────────────────────────────────────
MAX_REQUEST_SIZE=10485760

# ── Docs (disable in production) ───────────────────────────────────────
DOCS_ENABLED=false

# ── HSTS (enable behind TLS only) ──────────────────────────────────────
HSTS_ENABLED=false
